# Local secrets / config
.env
.env.local
*.local

# Oracle installer binaries (large, license-restricted — must never be committed)
binaries/
*.jar
*.zip
*.bin
*.rsp

# Runtime state if someone bind-mounts a host dir instead of using named volumes
domain/
oradata/
user_projects/

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
*~

# Claude Code local state
.claude/

# Build artifacts
*.log
logs/

# Volume snapshots (large; created by scripts/snapshot.sh)
snapshots/

# Local custom WCC components / drop-ins (each kept in its own repo)
components/
