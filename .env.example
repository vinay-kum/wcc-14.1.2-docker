# Copy to .env and edit. Never commit .env.
# All values below are sensible playground defaults — change passwords before any non-toy use.

# -----------------------------------------------------------------------------
# Image tags (pin these — `latest` drift will break reproducibility)
# -----------------------------------------------------------------------------
# Oracle AI Database 26ai Free. Confirm current tag at:
#   https://container-registry.oracle.com/ords/ocr/ba/database/free
DB_IMAGE=container-registry.oracle.com/database/free:latest

# Oracle WebCenter Content 14.1.2 CPU image. Confirm current dated tag at:
#   https://container-registry.oracle.com/ords/ocr/ba/middleware/webcenter-content_cpu
# Replace <TAG> with the dated tag shown there (e.g. 14.1.2.0.0-jdk17-ol8-260115).
WCC_IMAGE=container-registry.oracle.com/middleware/webcenter-content_cpu:14.1.2.0.0-<TAG>

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_SYS_PASSWORD=Welcome1_dbsys
DB_PDB=FREEPDB1
DB_HOST=db
DB_PORT=1521
DB_CONNECTION_STRING=db:1521/FREEPDB1

# -----------------------------------------------------------------------------
# RCU (Repository Creation Utility) — creates WCC schemas in the DB
# -----------------------------------------------------------------------------
RCU_PREFIX=WCC1
RCU_SCHEMA_PASSWORD=Welcome1_rcu

# -----------------------------------------------------------------------------
# WebLogic / WCC domain
# -----------------------------------------------------------------------------
DOMAIN_NAME=wcc_domain
ADMIN_USERNAME=weblogic
ADMIN_PASSWORD=Welcome1_wls
ADMIN_PORT=7001
ADMIN_SSL_PORT=7002

# Managed server ports (host-side; container ports stay at defaults inside)
UCM_PORT=16200
IBR_PORT=16250
WCC_ADFUI_PORT=16225
UCM_INTRADOC_PORT=4444
IBR_INTRADOC_PORT=5555

# Production mode: true for prod-like settings, false for development
PRODUCTION_MODE=false
