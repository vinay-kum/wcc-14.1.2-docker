# Copy to .env and edit. Never commit .env.
# All values below are sensible playground defaults — change passwords before
# any non-toy use. The variable names match Oracle's bundled bootstrap scripts
# inside /u01/oracle/container-scripts/ in the WCC image.

# -----------------------------------------------------------------------------
# Image tags (pin these — `latest` drift will break reproducibility)
# -----------------------------------------------------------------------------
# Oracle AI Database 26ai Free. Tag list:
#   https://container-registry.oracle.com/ords/ocr/ba/database/free
DB_IMAGE=container-registry.oracle.com/database/free:latest

# Oracle WebCenter Content 14.1.2. Tag list:
#   https://container-registry.oracle.com/ords/ocr/ba/middleware/webcenter-content
# Tag format: 14.1.2.0-<jdk>-<oslayer>-<yymmdd>  e.g. 14.1.2.0-jdk21-ol9-241205
WCC_IMAGE=container-registry.oracle.com/middleware/webcenter-content:14.1.2.0-jdk21-ol9-241205

# WCC images are linux/amd64 only. On Apple Silicon this triggers emulation.
WCC_PLATFORM=linux/amd64

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Used by the DB container itself (ORACLE_PWD) AND by WCC's RCU step
# (it's the SYS password used to create the FMW schemas).
DB_PASSWORD=Welcome1_dbsys
DB_PORT=1521
DB_CONNECTION_STRING=db:1521/FREEPDB1

# -----------------------------------------------------------------------------
# RCU (Repository Creation Utility) — runs inside wcc-admin on first start
# -----------------------------------------------------------------------------
DB_RCUPREFIX=WCC1
DB_SCHEMA_PASSWORD=Welcome1_rcu
# Set to "true" on first run if you previously had failed/partial schemas.
# Leave "false" otherwise — DROP is destructive.
DB_DROP_AND_CREATE=false

# -----------------------------------------------------------------------------
# WebLogic / WCC domain
# -----------------------------------------------------------------------------
DOMAIN_NAME=wcc_domain
ADMIN_USERNAME=weblogic
ADMIN_PASSWORD=Welcome1_wls
ADMIN_PORT=7001

# Managed server ports (host-side maps 1:1 to container ports)
UCM_PORT=16200
IBR_PORT=16250
UCM_INTRADOC_PORT=4444
IBR_INTRADOC_PORT=5555
